@startuml WarmHome ER Diagram

entity "User" as user {
  * id : UUID <<PK>>
  --
  * email : String <<Unique>>
  * password_hash : String
  * name : String
  * phone : String
  * created_at : Timestamp
}

entity "House" as house {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * address : String
  * area : Decimal(5,2)
  * timezone : String
}

entity "DeviceType" as device_type {
  * id : UUID <<PK>>
  --
  * name : String <<Unique>> (e.g. "Термостат", "Камера")
  * protocol : String (MQTT/RTSP)
  * capabilities : JSON
}

entity "Device" as device {
  * id : UUID <<PK>>
  --
  * type_id : UUID <<FK>>
  * house_id : UUID <<FK>>
  * serial_number : String <<Unique>>
  * status : Enum(online/offline/error)
  * installation_date : Date
  * config : JSON
}

entity "TelemetryData" as telemetry {
  * id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  * timestamp : Timestamp
  * metric_type : Enum(temperature/power/voltage)
  * value : Decimal(10,2)
  * raw_data : JSON
}

entity "Module" as module {
  * id : UUID <<PK>>
  --
  * name : String (e.g. "Отопление", "Освещение")
  * description : Text
}

entity "Rule" as rule {
  * id : UUID <<PK>>
  --
  * module_id : UUID <<FK>>
  * user_id : UUID <<FK>>
  * condition : JSON
  * action : JSON
  * priority : Integer
}

entity "UserHouseAccess" as access {
  * user_id : UUID <<FK>>
  * house_id : UUID <<FK>>
  --
  * role : Enum(owner/guest)
}

entity "DeviceModule" as device_module {
  * device_id : UUID <<FK>>
  * module_id : UUID <<FK>>
  --
  * config : JSON
}

user ||--o{ house : "owns"
house ||--o{ device : "contains"
device_type ||--o{ device : "classifies"
device ||--o{ telemetry : "generates"

module ||--o{ rule : "governs"
user ||--o{ rule : "creates"

user }o--|| access
house }o--|| access

device }o--|| device_module
module }o--|| device_module

@enduml
